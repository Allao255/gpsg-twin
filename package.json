{
  "name": "gpsg-twin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Configurador espelho do simulador GNSS GPSG-1000",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "gen": "tsx scripts/gen-model-types.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single && tsx scripts/check-single.ts",
    "preview": "vite preview --outDir dist/site"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "ajv": "^8.20.0",
    "eslint": "^10.13.0",
    "json-schema-to-typescript": "^16.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  }
}
